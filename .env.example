# Copy to .env (never commit .env). These are SERVER-side variables: do NOT prefix them with VITE_.
# Choose ONE provider.

# --- Option A: Anthropic (Claude) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5   # check the exact model id in your provider's console

# --- Option B: OpenAI or any OpenAI-compatible service (Chat Completions) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=<model id from your provider>
# LLM_BASE_URL=https://api.openai.com/v1     # change for compatible services (OpenRouter, Together, local vLLM/Ollama, ...)

# --- Optional ---
PORT=8787
LLM_MAX_TOKENS=700
LLM_TIMEOUT_MS=30000
RATE_LIMIT_PER_MIN=10        # per visitor IP
RATE_LIMIT_PER_DAY=150       # per visitor IP
GLOBAL_DAILY_LIMIT=3000      # all visitors together (caps your API cost)
MAX_CONCURRENT=8
TRUST_PROXY=0                # set 1 only behind a reverse proxy that sets X-Forwarded-For
ALLOWED_ORIGINS=             # comma-separated; only needed if the site is served from another origin
